# Copy to .dev.vars for `npm run dev`. Never deployed (wrangler deploy ignores this file).
# Values here override `vars` in wrangler.jsonc while running locally.

# Redirects, cookies and the Origin check all use this origin. `npm run dev` passes
# --local-upstream localhost:8787 so wrangler does not rewrite requests to the production route.
SITE_ORIGIN=http://localhost:8787

# The development OAuth App (callback http://localhost:8787/auth/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
