{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oogaboogaland",
	"main": "src/index.js",
	"compatibility_date": "2026-09-22",
	"account_id": "7ae75b38d6ca6906a7b8a047fd0f6f53",
	"observability": {
		"enabled": true
	},
	// Served only on the custom domain; oogabooga.land joins as a second route at cutover.
	"routes": [
		{
			"pattern": "obl.ruleswithoutrulers.com",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		// `npm run build:dist` at the repo root writes the built page here as index.html, with _headers.
		"directory": "../dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/auth/*",
			"/api/*"
		]
	},
	"vars": {
		// Local dev overrides both in .dev.vars (see .dev.vars.example).
		"SITE_ORIGIN": "https://obl.ruleswithoutrulers.com",
		"GITHUB_CLIENT_ID": "Ov23lig8Xi9sNWxUAZ7N"
		// Secret, never here: `npx wrangler secret put GITHUB_CLIENT_SECRET`.
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oogaboogaland",
			// From `npx wrangler d1 create oogaboogaland`.
			"database_id": "1226334b-5316-4695-a191-8a80a1a09f2e",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		// Sign-in starts per IP.
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 4 * * *"
		]
	}
}